<?xml version="1.0" encoding="utf-8" ?>
<component name="NightscoutTask" extends="Task">
  <!-- Interface block defines the shared memory between the render thread aka scene, and the task thread. -->
  <interface> 
    <!-- INPUT FIELDS are Written by scene, Read by task. -->
    <!--    Input Fields includes: action, nsUrl, nsToken, unitsMgdl, graphHours, bolusMinU, basalRender, settingsToSave. -->
    <!-- OUTPUT FIELDS are Written by task, Read by scene. -->
    <!--    Output Fields includes: result, settingsLoaded, profile, basalSchedule, nsCustomTitle, enabledPlugins, timeFormat, pillThresholds, batteryPct, pills, basals, treatments. -->
    <!--    alwaysNotify="true" on the output fields means the scene's observeFieldScoped callback will fire even if the value does not change, and avoids silently skipping callbacks. -->
    <field id="action"           type="string"       value="load"                          />
    <field id="nsUrl"            type="string"       value=""                              />
    <field id="nsToken"          type="string"       value=""                              />
    <field id="unitsMgdl"        type="boolean"      value="true"                          />
    <field id="graphHours"       type="integer"      value="4"                             />
    <field id="settingsToSave"   type="assocarray"                                         />
    <!-- Next, some OUTPUT FIELDS. Written by task, Read by scene. -->
    <field id="settingsLoaded"   type="assocarray"                     alwaysNotify="true" />
    <field id="result"           type="assocarray"                     alwaysNotify="true" />
    <field id="profile"          type="assocarray"                     alwaysNotify="true" />
    <!-- First, more INPUT FIELDS. Written by scene, Read by task. -->
    <field id="basalSchedule"    type="string"       value=""          alwaysNotify="true" />
    <field id="nsCustomTitle"    type="string"       value="__unset__" alwaysNotify="true" />
    <field id="enabledPlugins"   type="string"       value=""          alwaysNotify="true" />
    <field id="timeFormat"       type="integer"      value="12"        alwaysNotify="true" />
    <field id="pillThresholds"   type="string"       value=""          alwaysNotify="true" />
    <field id="batteryPct"       type="integer"      value="-1"        alwaysNotify="true" />
    <field id="pills"            type="string"       value=""          alwaysNotify="true" />
    <!-- Next, more INPUT FIELDS. Written by task, Read by scene. -->
    <field id="bolusMinU"        type="float"        value="0.5"                           />
    <field id="basalRender"      type="string"       value="icicle"                        />
    <field id="basals"           type="string"       value=""          alwaysNotify="true" />
    <field id="treatments"       type="string"       value=""          alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/NightscoutTask.brs" />
</component>
